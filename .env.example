# TRACE Environment Variables
# If you leave these blank, TRACE runs in Demo / Local Offline mode with rich simulated AI & local archive persistence.

# Google Gemini API Key (used for smart screenshot OCR, entity extraction & conversational assistant)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Credentials (optional - for cloud database & storage)
# If not provided, screenshots and metadata are stored seamlessly in browser localStorage / IndexedDB.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
